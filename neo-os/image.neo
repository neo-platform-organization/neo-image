(warp 1
  (entry workspace start)
  (object workspace
    (link calculations @arithmetic)
    (handler start
      (do (send @instrument sample 21)
          (if (= (send @sibling reading) 7)
              (send @instrument reading)
              0))))
  (object instrument
    (delegate @instrument-prototype)
    (link workspace @workspace)
    (link calculations @arithmetic)
    (slot level 0))
  (object sibling
    (delegate @instrument-prototype)
    (slot level 7))
  (object instrument-prototype
    (knight add left right (+ left right))
    (handler queue-increment amount (post self increment amount))
    (handler delay-increment amount (after 20 self increment amount))
    (handler increment amount (set self level (call self add (get self level) amount)))
    (handler sample input
      (do (if (< input 0) (return 0))
          (let staged (send self stage input)
            (set self level (call @arithmetic double staged)))))
    (handler stage input
      (do (set self level input)
          (return input)))
    (handler reading (get self level)))
  (object arithmetic
    (knight double value
      (let factor 2 (if (> value -1) (call @arithmetic multiply value factor) 0)))
    (knight multiply left right (* left right)))
  (object text-tool
    (package text-tools)
    (slot entry-selector "start")
    (slot instances "optional")
    (slot input "hello") (slot measurements 0)
    (slot io-status 0) (slot io-length 0) (slot received #)
    (slot file-revision 0)
    (knight add left right (+ left right))
    (knight byte-count text (text-length text))
    (handler start
      (if (= (argument-count) 0)
          (send self measure (get self input))
          (send self measure (argument 0))))
    (handler measure text
      (do (set self measurements (call self add (get self measurements) 1))
          (call self byte-count text)))
    (handler echo (io-write output self written (argument 0)))
    (handler read-input (io-read input self received-input 31))
    (handler save-input
      (store-write documents note (get self file-revision) self stored-input (get self input)))
    (handler load-input (store-read documents note self stored-input))
    (handler list-documents (store-list documents self received-input))
    (handler stored-input payload status length revision
      (do (set-bytes self received payload) (set self io-status status)
          (set self io-length length) (if (> revision 0) (set self file-revision revision))))
    (handler document-revision (get self file-revision))
    (handler received-input payload status length request
      (do (set-bytes self received payload) (set self io-status status) (set self io-length length)))
    (handler written payload status length request
      (do (set self io-status status) (set self io-length length)))
    (handler reading (get self measurements))
    (handler transfer-status (get self io-status))
    (handler transfer-length (get self io-length)))
  (object surface-exercise
    (package presentation)
    (slot width 0) (slot height 0) (slot scale 1000) (slot selected 0)
    (knight area width height (* width height))
    (knight flip value (- 1 value))
    (handler configure width height scale
      (do (set self width width) (set self height height) (set self scale scale) (send self draw)))
    (handler button code pressed x y
      (do (if (= code 1) (if (= pressed 1)
              (set self selected (call self flip (get self selected)))))
          (send self draw)))
    (handler pointer x y modifiers (get self selected))
    (handler wheel dx dy x y (get self selected))
    (handler key code pressed modifiers (get self selected))
    (handler focus focused (get self selected))
    (handler text value (text-length value))
    (handler draw
      (do (buffer-fill 0 (call self area (get self width) (get self height))
                       (if (= (get self selected) 0) 892679679 -1852730881))
          (buffer-present) (get self selected)))
    (handler bad-frame
      (do (set self selected 99) (buffer-fill -1 1 0) (buffer-present)))
    (handler reading (get self selected)))
  (object exercise-outsider
    (package outsider)
    (handler steal (read-document)))
  (object lifecycle-exercise
    (package exercise)
    (slot width 0) (slot height 0) (slot value 0)
    (slot active 0) (slot pulses 0) (slot saved 0)
    (knight add left right (+ left right))
    (knight area width height (* width height))
    (handler start
      (do (set self value (read-document)) (set self saved (get self value))
          (set self active 1) (after 20 self pulse)))
    (handler pulse
      (if (= (get self active) 1)
          (do (set self pulses (call self add (get self pulses) 1)) (after 20 self pulse))
          0))
    (handler stop (set self active 0))
    (handler running (get self active))
    (handler configure width height scale
      (do (set self width width) (set self height height) (send self draw)))
    (handler button code pressed x y
      (if (= code 1) (if (= pressed 1) (send self increment) 0) 0))
    (handler increment (set self value (call self add (get self value) 1)))
    (handler text value
      (set self value (call self add (get self value) (text-length value))))
    (handler key code pressed modifiers
      (if (= pressed 1)
          (if (= code 60) (send self save)
              (if (= code 61) (send self restore)
                  (if (= code 1) (send self stop) 0)))
          0))
    (handler pointer x y modifiers (get self value))
    (handler wheel dx dy x y (get self value))
    (handler focus focused (get self value))
    (handler save
      (do (write-document (get self value)) (set self saved (get self value))))
    (handler restore (set self value (read-document)))
    (handler reading (get self value))
    (handler saved-value (get self saved))
    (handler pulse-count (get self pulses))
    (handler bad-save
      (do (set self value 999) (write-document 999) (call self add 2147483647 1)))
    (handler mixed-save
      (do (set self value 999) (write-document 999) (buffer-present)))
    (handler draw
      (do (buffer-fill 0 (call self area (get self width) (get self height)) 892679679)
          (buffer-fill 0
            (call self area (get self width) (if (< (get self height) 20) (get self height) 20))
            (if (= (get self saved) (get self value)) 1268336639 -10145537))
          (buffer-fill 0
            (if (< (get self value) 0) 0
                (if (> (get self value) (call self area (get self width) (get self height)))
                    (call self area (get self width) (get self height)) (get self value)))
            -1)
          (buffer-present)))))
